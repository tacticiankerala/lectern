{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for every Lectern window",
  "windows": ["main", "win-*"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "dialog:allow-open"
  ]
}
